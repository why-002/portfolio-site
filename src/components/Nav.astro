---
// Import data
const portfolioData = await import("../data/portfolio.json");

const {
    name,
    title,
    description,
    experience,
    education,
    projects,
    contact,
    social,
} = portfolioData.default;
---

<nav
    class="flex justify-between items-center mb-16 opacity-60 hover:opacity-100 transition duration-1000 ease-in-out"
>
    <div class="flex flex-col md:flex-row justify-between w-full">
        <div class="text-4xl font-bold">
            <a href="/" class="hover:link decoration-1">wyatt rasmussen</a>
        </div>
        <div class="flex space-x-6 sm:mt-2 font-light">
            <a href="/work" class="hover:link decoration-1">Work</a>
            <a href="/work#projects" class="hover:link decoration-1">
                Projects
            </a>
              <a href="/contact" class="hover:link decoration-1">Contact</a>
        </div>
    </div>
</nav>
