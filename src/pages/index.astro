---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import headshot from "../img/headshot.webp";

// Import data
const portfolioData = await import("../data/portfolio.json");

const {
    name,
    title,
    description,
    experience,
    education,
    projects,
    contact,
    social,
} = portfolioData.default;
---

<link
    rel="preload"
    href={headshot.src}
    slot="afterhead"
    as="image"
    type="image/webp"
/>
<Layout>
    {/* Hero Section */}
    <section class="mb-20">
        <div class="flex flex-col md:flex-row items-start justify-between">
            <div class="md:w-1/2 mb-10 md:mb-0">
                <h1 class="hero-text font-bold mb-4">
                    hi, i'm <span class="text-primary">{name}</span>!
                </h1>
                <div set:html={description} class="text-xl mb-6 [&_p]:mb-8" />
            </div>
            <div class="md:w-1/2 md:flex justify-end hidden items-start h-full">
                <Image
                    src={headshot}
                    alt="Wyatt's Headshot"
                    class="border-2 border-primary rounded-full h-64 w-64 m-0"
                />
            </div>
        </div>
    </section>
</Layout>
